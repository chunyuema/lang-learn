#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

list_examples() {
    cat <<'EOF'
error-hierarchies       Compare typed error propagation in C++ and Rust
ownership-self-address Observe Rust moves, borrows, and object addresses
thread-lifetime        Observe C++ termination from an unjoined thread
thread-errors          Compare cross-thread failures in C++ and Rust
EOF
}

run_example() {
    case "$1" in
        error-hierarchies)
            sh "$repo_dir/examples/error-hierarchies/run.sh"
            ;;
        ownership-self-address)
            sh "$repo_dir/examples/ownership-and-borrowing/run.sh"
            ;;
        thread-lifetime)
            sh "$repo_dir/examples/thread-lifetime/run.sh"
            ;;
        thread-errors)
            sh "$repo_dir/examples/thread-errors/run.sh"
            ;;
        *)
            printf 'Unknown example: %s\n\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
}

usage() {
    cat <<EOF
Usage:
  ./run list
  ./run <example-id>
  ./run all
  ./run check

Examples:
$(list_examples)
EOF
}

case "${1:-list}" in
    list|-l|--list)
        list_examples
        ;;
    all)
        list_examples | while read -r example_id _; do
            printf '\n==> %s\n' "$example_id"
            run_example "$example_id"
        done
        ;;
    check)
        sh "$repo_dir/examples/error-hierarchies/cpp/check.sh"
        sh "$repo_dir/examples/thread-errors/run.sh" >/dev/null 2>&1
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        run_example "$1"
        ;;
esac
